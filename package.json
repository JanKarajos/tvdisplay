{
  "name": "songdisplay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite \"npm run server\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "prod": "vite build && node server/index.js --serve",
    "start": "node server/index.js --serve",
    "start:all": "npm run dev",
    "start:alt": "vite --host --port 5174",
    "preview": "vite preview",
    "create-github-repo": "node ./scripts/create_github_repo.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@vitejs/plugin-react": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "node-fetch": "^2.6.7",
    "pdfjs-dist": "5.4.296",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^5.0.0"
  }
}

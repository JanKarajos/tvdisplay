# Konfigurácia TVDisplay servera (skopíruj ako .env)

# GitHub Personal Access Token s oprávnením "repo" – ostáva iba na serveri
# Vytvorte ho na: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=JanKarajos
GITHUB_REPO=tvdisplay
GITHUB_BRANCH=main

# PIN na ovládanie (prázdne = bez PIN). Displej PIN nepotrebuje.
CONTROL_PIN=

# Port API a synchronizácie (WebSocket)
STATE_PORT=3002
# Port aplikácie v produkcii (npm run prod)
APP_PORT=5173

# Cesta k LibreOffice pre prevod PowerPointu (nepovinné, hľadá sa automaticky)
# SOFFICE_PATH=/usr/bin/soffice

# --- Administrácia kostolov (iba na NAS) ---
# Priečinok s používateľmi, kostolmi a ich obsahom; zapne stránku /#admin
# ADMIN_DATA_DIR=./admin-data
# Prvý administrátor (iba pri prvom spustení)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# --- Orange Pi napojené na administráciu ---
# Adresa kostola zo záložky Kostoly; piesne sa potom neberú z GitHubu
# CHURCH_DATA_URL=https://mojnas.synology.me/api/public/churches/kostol-sv-martina
# Ako často kontrolovať zmeny (sekundy)
# CHURCH_SYNC_SECONDS=60
